# ==============================================================================
# SARA - Cognitive Extortion Response Agent: Environment Configuration
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8080

# Google AI Studio / Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.7-flash

# Google Cloud Platform (GCP) & Vertex AI
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
USE_VERTEX=false

# Google Cloud Firestore Configuration
FIRESTORE_DATABASE=(default)
FIRESTORE_EMULATOR_HOST=

# External Integrations (Optional / Multi-channel Alerting & Voice)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MAKE_WEBHOOK_URL=https://hook.eu2.make.com/your-webhook-endpoint
MAKE_WEBHOOK_VALIDACION_URL=https://hook.eu2.make.com/your-biometric-webhook
VAPI_PUBLIC_KEY=your_vapi_public_key
VAPI_ASSISTANT_ID=your_vapi_assistant_id
